# ========================================================
# SSG PRODUCTION ENVIRONMENT TEMPLATE (.env.prod)
# Sao chép file này thành .env.prod trong thư mục deploy/
# ========================================================

# Khóa bảo mật cơ sở dữ liệu
POSTGRES_PASSWORD=Thay_Bang_Mat_Khau_Postgres_Ngau_Nhien_Rat_Manh_2026

# Phiên đăng nhập & Mã hóa dữ liệu AI / Tệp tin
SESSION_SECRET=Thay_Bang_Chuoi_Ngau_Nhien_Bao_Mat_It_Nhat_32_Ky_Tu_2026
# 64 ký tự hex ngẫu nhiên (32 bytes AES-256): ví dụ chạy `openssl rand -hex 32`
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cấu hình Tên miền và Cookie
CLIENT_URL=https://studymap.online
COOKIE_DOMAIN=studymap.online
COOKIE_SECURE=true

# Email gửi đi (nếu tích hợp SMTP ngoài, còn mặc định đã có Mailpit nội bộ)
# SMTP_HOST=ssg-mailpit
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="StudyMap Sinh Viên <no-reply@studymap.online>"

# Giữ nguyên cấu hình lưu trữ
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/apps/server/uploads
STORAGE_QUARANTINE_PATH=/app/apps/server/uploads/quarantine
STORAGE_PUBLIC_PATH=/app/apps/server/uploads/public

# Worker xử lý ảnh ngầm
MEDIA_WORKER_MODE=queue
