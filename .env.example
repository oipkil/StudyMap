# ========================================================
# SSG ENVIRONMENT CONFIGURATION (Phiên bản: 17/09/2026)
# ========================================================

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database & Cache
DATABASE_URL=postgresql://ssg_admin:ssg_secret_password_2026@localhost:5434/ssg_db?schema=public
REDIS_URL=redis://localhost:6380

# Security & Sessions
SESSION_SECRET=ssg_super_secure_session_secret_key_minimum_32_chars_2026
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 64 hex chars (32 bytes AES-256)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Mail (Mailpit dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SSG Sinh Viên <no-reply@ssg.edu.vn>"

# Object Storage / Local Storage Adapter
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_QUARANTINE_PATH=./uploads/quarantine
STORAGE_PUBLIC_PATH=./uploads/public

# MapLibre Tile & Geocoding
MAP_TILE_URL=https://tiles.openfreemap.org/styles/liberty/{z}/{x}/{y}.png
GEOCODING_ENDPOINT=https://photon.komoot.io/api

# AI Multi-Provider Configuration & Security
# Master encryption key (64 hex characters / 32 bytes) used for AES-256-GCM encryption of provider API keys
# WARNING: NEVER COMMIT LIVE API KEYS OR MASTER ENCRYPTION KEYS TO SOURCE CONTROL!
# All provider API keys must be registered via the Admin Dashboard UI (/admin/ai) and are encrypted at rest.
AI_TRUSTED_INTERNAL_HOSTS= # Comma-separated list of allowed internal hosts for SSRF bypass (e.g., "localhost:11434,127.0.0.1:11434" for Ollama)
AI_TEST_OPENAI_COMPATIBLE_URL= # Optional: Real provider endpoint for live integration testing (e.g., https://api.openai.com/v1)
AI_TEST_OPENAI_COMPATIBLE_KEY= # Optional: Real API key for live integration testing (kept strictly in local .env, skipped in CI)

MEDIA_WORKER_MODE= # 'queue' để dùng BullMQ worker riêng (production); để trống = xử lý ảnh ngay trong API (dev)

# Đặt 1 khi chạy sau nginx/Cloudflare để rate-limit theo IP thật
TRUST_PROXY=1
